{
  "manifest_version": 3,
  "name": "ISP Speed Logger",
  "version": "1.3.0",
  "description": "Runs a speed test on a schedule and logs the results to CSV and/or a shared Google Sheet.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "https://ams.speedtest.clouvider.net/*",
    "https://fra.speedtest.clouvider.net/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "ISP Speed Logger", "default_icon": { "16": "icons/on-16.png", "32": "icons/on-32.png" } }
}
